router.post(
  '/:conversationId/voice',
  requireAuth,
  requireCsrf,
  upload.single('file'),

  async (req, res, next) => {
    const conversationId =
      req.params.conversationId;

    const userId =
      req.session.userId;


    if (
      !isUuid(conversationId)
    ) {
      return res
        .status(400)
        .json({
          error:
            'Conversation invalide.',
        });
    }


    if (!req.file) {
      return res
        .status(400)
        .json({
          error:
            'Aucun enregistrement audio reçu.',
        });
    }


    if (
      req.file.size <= 0
    ) {
      return res
        .status(400)
        .json({
          error:
            'Enregistrement audio vide.',
        });
    }


    if (
      !isAllowedVoiceMime(
        req.file.mimetype
