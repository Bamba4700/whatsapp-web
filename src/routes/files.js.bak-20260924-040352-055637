/*
 * =========================================================
 * LECTURE / TÉLÉCHARGEMENT FICHIER
 *
 * GET /api/messages/:messageId/file
 * =========================================================
 */

router.get(
  '/messages/:messageId/file',
  requireAuth,

  async (req, res, next) => {
    const messageId =
      req.params.messageId;


    if (!isUuid(messageId)) {
      return res
        .status(400)
        .json({
          error:
            'Message invalide.',
        });
    }


    try {
      const result =
        await pool.query(
          `
            SELECT
              m.storage_bucket,
              m.storage_key,
              m.original_name,
              m.mime_type,
              m.size_bytes

            FROM messages m

            JOIN conversation_members cm
              ON cm.conversation_id =
                 m.conversation_id

            WHERE
              m.id = $1
              AND m.kind = 'file'
              AND cm.user_id = $2
              AND cm.left_at IS NULL

            LIMIT 1
          `,
          [
            messageId,
            req.session.userId,
          ]
        );


      if (
        result.rowCount === 0
      ) {
        return res
          .status(404)
          .json({
            error:
              'Fichier introuvable.',
          });
      }


      const file =
        result.rows[0];


      const safeInlineTypes =
        new Set([
          'image/jpeg',
          'image/png',
          'image/gif',
          'image/webp',
        ]);


      const download =
        req.query.download === '1';


      const disposition =
        download ||
        !safeInlineTypes.has(
          file.mime_type
        )
          ? 'attachment'
          : 'inline';


      res.set(
        'Content-Type',
        file.mime_type ||
        'application/octet-stream'
      );


      res.set(
        'X-Content-Type-Options',
        'nosniff'
      );


      if (
        file.size_bytes !== null
      ) {
        res.set(
          'Content-Length',
          String(
            file.size_bytes
          )
        );
      }


      res.set(
        'Content-Disposition',
        contentDisposition(
          disposition,
          file.original_name,
          'fichier'
        )
      );


      const stream =
        await storage.getObject(
          file.storage_bucket,
          file.storage_key
        );


      stream.on(
        'error',
        next
      );


      stream.pipe(res);

    } catch (error) {
      next(error);
    }
  }
);


